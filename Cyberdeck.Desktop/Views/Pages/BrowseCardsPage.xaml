<Page x:Class="Cyberdeck.Desktop.Views.Pages.BrowseCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: FILTER PANEL -->
        <Border Grid.Column="0"
                Padding="12"
                Margin="0,0,12,0"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="Filters"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Search"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,16"/>

                <TextBlock Text="Color"/>
                <ComboBox ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding SelectedColor}"
                          Margin="0,4,0,16"/>

                <TextBlock Text="Type"/>
                <ComboBox ItemsSource="{Binding Types}"
                          SelectedItem="{Binding SelectedType}"
                          Margin="0,4,0,16"/>
            </StackPanel>
        </Border>

        <!-- CENTER: CARD LIST -->
        <DataGrid Grid.Column="1"
                  ItemsSource="{Binding Cards}"
                  SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Color"
                                    Binding="{Binding Color}"
                                    Width="100"/>

                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="100"/>

                <DataGridTextColumn Header="Class"
                                    Binding="{Binding Classification}"
                                    Width="120"/>

                <DataGridTextColumn Header="Cost"
                                    Binding="{Binding Cost}"
                                    Width="70"/>

                <DataGridTextColumn Header="Power"
                                    Binding="{Binding Power}"
                                    Width="70"/>

                <DataGridTextColumn Header="RAM"
                                    Binding="{Binding Ram}"
                                    Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- RIGHT: CARD DETAIL PANEL -->
        <Border Grid.Column="2"
                Padding="16"
                Margin="12,0,0,0"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="{Binding SelectedCard.Name}"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{Binding SelectedCard.Type}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock Text="{Binding SelectedCard.Classification}"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="Color: "
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCard.Color}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="Cost: "
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCard.Cost}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="Power: "
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCard.Power}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock Text="RAM: "
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCard.Ram}"/>
                </StackPanel>

                <Separator Margin="0,8,0,16"/>

                <TextBlock Text="Rules Text"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{Binding SelectedCard.RulesText}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Set"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Text="{Binding SelectedCard.SetName}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>